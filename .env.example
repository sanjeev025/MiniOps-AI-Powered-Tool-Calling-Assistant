# ==============================================================================
# MiniOps — Environment Configuration Template
# Copy this file to `.env` and fill in your actual credentials.
# Never commit real credentials to version control.
# ==============================================================================

# --- LLM Provider & Model Selection ---
# Choose your active provider and model:
# Supported providers:
#   - groq        (models: openai/gpt-oss-120b, openai/gpt-oss-20b) -> Ultra-fast LPU inference!
#   - openai-api  (models: gpt-4o, gpt-4o-mini)
#   - xai         (models: grok-2, grok-beta)
#   - anthropic   (models: claude-sonnet-4-6, claude-3-5-haiku-latest)
#   - openrouter  (models: meta-llama/llama-3.3-70b-instruct, openai/gpt-4o)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# --- LLM Provider Credentials ---
# Supply the API key corresponding to your chosen LLM_PROVIDER:
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
XAI_API_KEY=your_xai_grok_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Optional Custom Endpoints ---
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Langfuse Observability Configuration ---
# Standard Langfuse SDK credentials (Cloud or Self-Hosted)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Hermes Langfuse Plugin settings (auto-forwarded by run_agent.sh)
HERMES_LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
HERMES_LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
HERMES_LANGFUSE_BASE_URL=https://cloud.langfuse.com
HERMES_LANGFUSE_ENV=development
HERMES_LANGFUSE_SAMPLE_RATE=1.0

# --- Demo API Service Configuration ---
DEMO_API_HOST=127.0.0.1
DEMO_API_PORT=8000
UTCP_MANUAL_URL=http://127.0.0.1:8000/utcp
